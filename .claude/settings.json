{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_tool_use.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "uv run -q \"${CLAUDE_PROJECT_DIR}/.claude/hooks/commit_judge.py\"",
            "timeout": 420
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_gate.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
